; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Boomer Shooter"
config/description="FPS arcade de alta movilidad por Stealth Proyects."
config/version="1.2.9"
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://Assets/Brand/boot_splash.png"
boot_splash/use_filter=true
boot_splash/minimum_display_time=2
config/copyright="© 2026 xpe.nettt · Stealth Proyects"
run/main_scene="res://Levels/MainMenu.tscn"
run/max_fps=0
run/low_processor_mode=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://Assets/Brand/icon_512.png"

[audio]

driver/enable_input=true
default_bus_layout="res://default_bus_layout.tres"

[input_devices]

pointing/emulate_mouse_from_touch=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[autoload]

PatchLoader="*res://Scripts/patch_loader.gd"
Global="*res://Scripts/global.gd"
GameSettings="*res://Scripts/game_settings.gd"
Mando="*res://Scripts/mando.gd"
Cargador="*res://Scripts/cargador.gd"
Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
UpdateManager="*res://Scripts/update_manager.gd"
OnlineManager="*res://Scripts/online_manager.gd"
GameChat="*res://Scripts/game_chat.gd"
VoiceManager="*res://Scripts/voice_manager.gd"
TeamAlerts="*res://Scripts/team_alerts.gd"
BotManager="*res://Scripts/Bots/bot_manager.gd"
Shop="*res://Scripts/shop.gd"
Achievements="*res://Scripts/achievements.gd"
LogroAviso="*res://Scripts/logro_aviso.gd"
MusicDirector="*res://Scripts/music_director.gd"
MapBuilder="*res://Scripts/map_builder.gd"
CloudSync="*res://Scripts/cloud_sync.gd"
DiscordPresence="*res://Scripts/discord_presence.gd"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=1

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://Assets/Itch/": "gray",
"res://Levels/": "orange",
"res://Player/": "red",
"res://Resources/": "green",
"res://Scenes/": "teal",
"res://Scripts/": "pink",
"res://Shaders/": "purple",
"res://addons/": "gray"
}

