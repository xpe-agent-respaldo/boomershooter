[rendering]

renderer/rendering_method="gl_compatibility"
gl_compatibility/driver.windows="opengl3_angle"
gl_compatibility/fallback_to_native=true
gl_compatibility/fallback_to_angle=true
gl_compatibility/item_buffer_size=16384
anti_aliasing/quality/msaa_3d=1
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=1024
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
